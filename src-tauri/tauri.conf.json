{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamTunnel",
  "version": "0.1.1",
  "identifier": "app.streamtunnel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StreamTunnel",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0B0B0C",
        "additionalBrowserArgs": "--enable-features=WebRtcAV1HWEncode --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,WebRTCColorAccuracy,WebRtcHideLocalIpsWithMdns --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss:; media-src 'self' blob: mediastream:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "net",
        "depends": [
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0",
          "libgstreamer-plugins-bad1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-nice",
          "gstreamer1.0-libav",
          "gstreamer1.0-pulseaudio"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
